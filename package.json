{
  "name": "talepickle",
  "version": "1.0.0",
  "description": "TalePickle - Interactive illustrated kids storybook with voice narration and speed control",
  "homepage": "https://talepickle.com",
  "main": "src/ui/main.js",
  "scripts": {
    "start": "node scripts/serveUi.js 8080",
    "dev": "node scripts/serveUi.js 8080",
    "build": "python3 scripts/build_docs.py",
    "generate:audio": "python3 scripts/generate_audio.py",
    "generate:svgs": "node scripts/generate_story_svgs.js",
    "test": "python3 -m pytest src/data/test_stories.py -v"
  },
  "keywords": [
    "storybook",
    "children-stories",
    "fables",
    "text-to-speech",
    "tts",
    "svg-animation",
    "github-pages"
  ],
